{
  "name": "@chillops/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:verify-schema": "node scripts/verify-schema.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:check": "node scripts/seed-check.mjs",
    "db:seed:reset": "node scripts/seed-reset.mjs",
    "auth:create-user": "node scripts/create-user.mjs",
    "auth:benchmark": "node scripts/auth-benchmark.mjs"
  },
  "dependencies": {
    "@chillops/shared": "workspace:*",
    "@neondatabase/serverless": "1.2.1",
    "drizzle-orm": "0.45.4",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "wrangler": "^4.162.0"
  }
}
