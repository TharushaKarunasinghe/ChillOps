{
  "name": "chillops",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/ensure-web-assets.mjs && pnpm --parallel --filter @chillops/web --filter @chillops/api run dev",
    "build": "pnpm --filter @chillops/shared build && pnpm --filter @chillops/web build && pnpm --filter @chillops/api build",
    "release": "pnpm --filter @chillops/web build && pnpm --filter @chillops/api exec wrangler deploy",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --project tsconfig.json && pnpm -r run typecheck",
    "test": "vitest run",
    "auth:benchmark": "pnpm --filter @chillops/api auth:benchmark",
    "design:contrast": "pnpm --filter @chillops/web design:contrast"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
